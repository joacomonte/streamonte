{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noImplicitAny": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["./src/globals.d.ts"],
    "paths": { "svelte": ["../../ui/node_modules/svelte"], "svelte/*": ["../../ui/node_modules/svelte/*"] }
  },
  "include": ["src"]
}
