#!/bin/sh
# Antes de cada push, el mismo CI que GitHub (scripts/ci-local.sh, 2026-11-23). Un push de solo tags (release) no lo
# repite: ese commit ya pasó al pushear la rama. Saltearlo en una urgencia: git push --no-verify
only_tags=1
while read -r local_ref _ _ _; do
  case "$local_ref" in refs/tags/*) ;; *) only_tags=0 ;; esac
done
[ $only_tags = 1 ] && exit 0
echo "pre-push: corriendo el CI local (sh scripts/ci-local.sh)…"
exec sh "$(git rev-parse --show-toplevel)/scripts/ci-local.sh"
