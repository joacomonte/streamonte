{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],
    "types": [
      "./src/globals.d.ts",
      "../packages/ui/src/globals.d.ts"
    ],
    "checkJs": true,
    "allowJs": true,
    "strict": true,
    "moduleDetection": "force",
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "svelte": [
        "./node_modules/svelte"
      ],
      "svelte/*": [
        "./node_modules/svelte/*"
      ],
      "$ui/*": [
        "../packages/ui/src/*"
      ]
    }
  },
  "include": [
    "src/*.js"
  ]
}
