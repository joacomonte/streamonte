{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "svelte",
      "vite/client"
    ],
    "allowImportingTsExtensions": true,
    "noImplicitAny": true,
    "paths": {
      "$ui/*": [
        "../packages/ui/src/*"
      ],
      "svelte": [
        "./node_modules/svelte"
      ],
      "svelte/*": [
        "./node_modules/svelte/*"
      ]
    }
  },
  "include": [
    "src/main.ts",
    "src/**/*.svelte",
    "src/**/*.ts",
    "../packages/ui/src/**/*.ts",
    "../packages/ui/src/**/*.svelte",
    "vite.config.ts"
  ],
  "exclude": []
}
