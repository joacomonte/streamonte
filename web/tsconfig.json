{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"types": [
			"$app/types",
			"node"
		],
		"paths": {
			"$ui/*": [
				"../packages/ui/src/*"
			],
			"svelte": [
				"./node_modules/svelte"
			],
			"svelte/*": [
				"./node_modules/svelte/*"
			]
		},
		"noImplicitAny": true
	},
	"include": [
		"src",
		"vite.config.ts"
	]
}
