{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Streamonte",
  "version": "0.3.0",
  "identifier": "app.tstream.v2",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Streamonte",
        "width": 1100,
        "height": 720,
        "maximized": true,
        "minWidth": 760,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [],
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI1OUMzODVDM0JCMDEzQUUKUldTdUU3QTdYRGljdFNoOHFZVDdQZEtxME4yOWN4MVdQenF2T0Uza1dBb2RpQlhadTB2N1Q3OWMK",
      "endpoints": [
        "https://github.com/joacomonte/tstream-v2/releases/latest/download/latest.json"
      ]
    }
  }
}
