{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Streamonte",
  "version": "3.0.1",
  "identifier": "app.streamonte",
  "build": {
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../ui/dist",
    "beforeDevCommand": "cd ui && corepack pnpm dev"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Streamonte",
        "width": 1100,
        "height": 720,
        "maximized": true,
        "minWidth": 760,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src ipc: http://ipc.localhost ws://127.0.0.1:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [],
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    },
    "resources": {
      "mpv/": "mpv/"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI1OUMzODVDM0JCMDEzQUUKUldTdUU3QTdYRGljdFNoOHFZVDdQZEtxME4yOWN4MVdQenF2T0Uza1dBb2RpQlhadTB2N1Q3OWMK",
      "endpoints": [
        "https://github.com/joacomonte/streamonte/releases/latest/download/latest.json"
      ]
    }
  }
}
